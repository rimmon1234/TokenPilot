# TokenPilot Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hugging Face Hub (Optional for discovery of public models; improves rate limits)
# HF_TOKEN=hf_your_personal_token_here

# SQLite Database for Backend State / Sync (Future M3-M7)
DATABASE_URL=sqlite:///./token_pilot.db

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000/api
